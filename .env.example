DATABASE_URL=postgres://padel:padel@localhost:5432/padel_quento
# Certificado de la CA de Supabase (solo producción, ver README > Deploy). Vacío en local: sin SSL.
DATABASE_SSL_CA=
NEXTAUTH_SECRET=reemplazar-con-un-secreto-largo
NEXTAUTH_URL=http://localhost:3000

POSTGRES_USER=reemplazar-con-usuario
POSTGRES_PASSWORD=reemplazar-con-contraseña
POSTGRES_DB=reemplazar-con-nombre-de-base-de-datos

# Avisos por correo (SMTP). Sin SMTP_HOST no se envían correos.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM="Quento Padel Club <avisos@quento.com>"

# Avisos por WhatsApp Cloud API (Meta). Sin token ni id de número no se envían WhatsApps.
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_TEMPLATE_LANGUAGE=es_AR

# Botón flotante de WhatsApp para contactar al complejo (opcional: sin número no se muestra).
# Número en formato internacional (celular de Argentina: 54 9 + área + número). Se toman al hacer el build.
NEXT_PUBLIC_WHATSAPP_CONTACT_NUMBER=
NEXT_PUBLIC_WHATSAPP_CONTACT_MESSAGE="Hola, quiero hacer una consulta sobre Quento Club."

# Dueño que crea `pnpm db:seed:prod` en producción (opcional: sin estas variables no lo crea).
# Completarlas solo al correr el seed; no commitear valores reales.
SEED_OWNER_EMAIL=
SEED_OWNER_PASSWORD=
SEED_OWNER_NAMES=
SEED_OWNER_LASTNAMES=
SEED_OWNER_DNI=
