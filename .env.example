DATABASE_URL=postgres://padel:padel@localhost:5432/padel_quento
NEXTAUTH_SECRET=reemplazar-con-un-secreto-largo
NEXTAUTH_URL=http://localhost:3000

POSTGRES_USER=reemplazar-con-usuario
POSTGRES_PASSWORD=reemplazar-con-contraseña
POSTGRES_DB=reemplazar-con-nombre-de-base-de-datos

# Avisos por correo (SMTP). Sin SMTP_HOST no se envían correos.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM="Quento Padel Club <avisos@quento.com>"

# Avisos por WhatsApp Cloud API (Meta). Sin token ni id de número no se envían WhatsApps.
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_TEMPLATE_LANGUAGE=es_AR

# Zona horaria del club: los timestamps de la base se escriben y leen con la hora local del proceso.
TZ=America/Argentina/Buenos_Aires
