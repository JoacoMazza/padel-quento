{
  "name": "padel-quento",
  "version": "0.1.0",
  "pnpm": {
    "overrides": {
      "vite": "^8.2.4"
    }
  },
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test": "vitest run --config vitest.config.ts",
    "test:watch": "vitest --config vitest.config.ts",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "test:integration:watch": "vitest --config vitest.integration.config.ts",
    "test:integration:db:up": "docker compose -f docker-compose.test.yml up -d",
    "test:integration:db:down": "docker compose -f docker-compose.test.yml down -v",
    "test:all": "pnpm test && pnpm test:integration",
    "typeorm": "typeorm-ts-node-commonjs -d src/lib/data-source.ts",
    "migration:generate": "pnpm typeorm migration:generate",
    "migration:create": "typeorm-ts-node-commonjs migration:create",
    "migration:run": "pnpm typeorm migration:run",
    "migration:revert": "pnpm typeorm migration:revert",
    "migration:show": "pnpm typeorm migration:show",
    "db:seed": "ts-node -r tsconfig-paths/register --project tsconfig.json scripts/seed.ts",
    "db:seed:prod": "ts-node -r tsconfig-paths/register --project tsconfig.json scripts/seed-production.ts",
    "db:seed:bookings": "ts-node -r tsconfig-paths/register --project tsconfig.json scripts/seed-bookings.ts"
  },
  "dependencies": {
    "bcrypt": "^6.0.0",
    "cookie-parser": "^1.4.7",
    "dotenv": "^18.0.9",
    "jsonwebtoken": "^9.0.3",
    "lucide-react": "^1.61.0",
    "next": "16.4.3",
    "next-auth": "^4.24.15",
    "nodemailer": "^10.2.1",
    "pg": "^8.23.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "reflect-metadata": "^0.2.2",
    "typeorm": "^1.1.2"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/bcrypt": "^6.0.0",
    "@types/node": "^26.6.5",
    "@types/nodemailer": "^8.0.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^10.13.0",
    "eslint-config-next": "16.4.3",
    "jsdom": "^30.1.3",
    "tailwindcss": "^4.3.3",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  },
  "packageManager": "pnpm@10.33.4"
}
