---
title: Diagrama de Clases Padel Quento
config:
  layout: elk
---
%% Source of truth for the class diagram (rendered to classes.jpg).
%% Convention: an association end without multiplicity means exactly 1.
classDiagram
    direction TB

    class Account {
        -email: char
        -isBlocked: boolean
        -passwordHashed: char
        +block()
        +register()
        +signIn()
        +signOut()
        +unBlock()
    }

    class Admin {
        -accessLevel: AdminAccessLevel
        -dni: int
        -lastNames: char
        -names: char
    }

    class Booker {
        -lastNames: char
        -names: char
        -phoneNumber: char
    }

    class Player {
        -category: PlayerCategory
        -scoring: int
        +addPoints(points: int)
        +deductPoints(points: int, reason: char)
        +calculateReputation()
    }

    class Lesson {
        -classCapacity: int
        -createdAt: LocalDateTime
        -fromLocalDatetime: LocalDateTime
        -isActive: boolean
        -price: float
        -toLocalDatetime: LocalDateTime
        +enrollStudent(player: Player)
        +unenrollStudent(player: Player)
        +hasCapacity() boolean
        +generateBookings()
        +deactivate()
    }

    class LessonSchedule {
        -dayOfWeek: DayOfWeek
        -endTime: LocalTime
        -startTime: LocalTime
    }

    class Penalty {
        -createdAt: LocalDateTime
        -penalizedScoring: int
        -reason: char
        +calculateAmount() int
    }

    class Complex {
        -address: char
        -city: char
        -country: char
        -latitude: float
        -longitude: float
        -mapsUrl: char
        -name: char
        -postalCode: char
        -province: char
        -whatsappMessage: char
        -whatsappNumber: char
    }

    class Court {
        -number: int
        -price: float
        -state: CourtState
        -slotDurationMinutes: int
        +block()
        +checkAvailability()
        +unBlock()
    }

    class Schedule {
        -closingTime: LocalTime
        -dayOfWeek: DayOfWeek
        -openingTime: LocalTime
        +isWithinOpeningHours() boolean
    }

    class OutOfService {
        -description: char
        -fromDatetime: LocalDateTime
        -reason: OutOfServiceReason
        -toDatetime: LocalDateTime
        +cancelAffectedBookings()
        +isActive() boolean
    }

    class Booking {
        -bookingState: BookingState
        -durationMinutes: int
        -fromDatetime: LocalDateTime
        -isPaid: boolean
        -price: float
        -attended: boolean
        +cancel()
        +availableSpots() int
        +registerAttendance(present: boolean)
        +isLateCancellation() boolean
        +finish()
    }

    class Inscription {
        -createdAt: LocalDateTime
    }

    class FixedBooking {
        -createdAt: LocalDateTime
        -durationMinutes: int
        -endDate: LocalDate
        -frequency: FixedBookingFrequency
        -isActive: boolean
        -startDate: LocalDate
        -startTime: LocalTime
        +generateDates()
        +checkConflicts()
        +deactivate()
    }

    class FixedBookingDate {
        -date: LocalDate
        -state: FixedBookingDateState
        +release()
    }

    class Match {
        -needPlayers: boolean
        -category: PlayerCategory
        +addPlayer()
        +removePlayer(player: Player)
        +cancel()
        +checkNeedsPlayers()
        +close() int
        +notifyPlayers() int
        +canReview(player: Player) boolean
    }

    class MatchPlayer {
        -attendedCount: int
        -joinedAt: LocalDateTime
        -playersCount: int
        -pointsAwarded: int
        +registerAttendance(count: int)
        +calculatePoints() int
    }

    class PlayerReview {
        -comment: char
        -createdAt: LocalDateTime
        -goodAttitude: boolean
        -level: ReviewLevel
        -onTime: boolean
        +register()
    }

    class Chat {
        -isOpen: boolean
        -createdAt: LocalDateTime
        +addMessages()
        +close()
        +listMessages()
    }

    class Message {
        -content: char
        -sentAt: LocalDateTime
        +send()
    }

    class AdminAccessLevel {
        <<enumeration>>
        owner
        staff
    }

    class FixedBookingFrequency {
        <<enumeration>>
        weekly
        biweekly
    }

    class FixedBookingDateState {
        <<enumeration>>
        booked
        released
        conflict
    }

    class ReviewLevel {
        <<enumeration>>
        lower
        as_declared
        higher
    }

    class OutOfServiceReason {
        <<enumeration>>
        maintenance
        free_day
        cleaning
        other
    }

    class CourtState {
        <<enumeration>>
        available
        closed_down
    }

    class BookingState {
        <<enumeration>>
        reserved
        finished
        cancelled
    }

    class DayOfWeek {
        <<enumeration>>
        monday
        tuesday
        wednesday
        thursday
        friday
        saturday
        sunday
    }

    class PlayerCategory {
        <<enumeration>>
        1st
        2nd
        3rd
        4th
        5th
        6th
        7th
        without_category
    }

    %% Inheritance
    Booker <|-- Player

    %% Accounts
    Admin "0..1" -- Account
    Account -- "0..1" Player

    %% Players
    Player -- "*" Penalty
    Player "1" -- "0..*" MatchPlayer
    Player "1" -- "0..*" Inscription
    Player -- "0..*" PlayerReview : +reviewer
    Player -- "0..*" PlayerReview : +reviewed
    Player "1" -- "0..*" Message : +sender

    %% Matches
    Match *-- "0..4" MatchPlayer
    Match *-- "0..1" Chat
    Chat *-- "0..*" Message
    PlayerReview "0..*" -- Match
    Match "0..1" -- Booking

    %% Bookings
    Booker -- "*" Booking
    Booking "0..1" -- "0..1" FixedBookingDate
    Booking "0..1" -- "*" Penalty
    Booker -- "*" FixedBooking
    FixedBooking -- "*" FixedBookingDate
    FixedBooking "0..*" -- Court

    %% Lessons
    Player -- "0..*" Lesson : +teacher
    Lesson -- "*" Inscription
    Lesson "0..1" -- "*" Booking
    Lesson *-- "1..*" LessonSchedule
    Court -- "0..*" LessonSchedule

    %% Courts
    Complex -- "*" Court
    Court -- "*" Booking
    Court -- "0..*" OutOfService
    Schedule "1..7" -- Court
